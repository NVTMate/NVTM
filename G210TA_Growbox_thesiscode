// WIFI SETUP
void connectWiFi() {
  WiFi.begin(WIFI_SSID, WIFI_PASSWORD);

  Serial.print("Connecting to WiFi");

  int attempts = 0;

  while (WiFi.status() != WL_CONNECTED && attempts < 40) {
    Serial.print(".");
    delay(500);
    attempts++;
  }

  Serial.println();

  if (WiFi.status() == WL_CONNECTED) {
    Serial.print("WiFi connected. IP: ");
    Serial.println(WiFi.localIP());
  } else {
    Serial.println("WiFi connection failed. Running offline.");
  }
}

// SETUP
void setup() {
  Serial.begin(115200);
  delay(1000);

  Serial.println("Starting Grow Box...");

  prefs.begin("growbox", false);

  savedRuntimeMs = prefs.getULong64("runtimeMs", 0);
  bootTimeMs = nowMs();

  int savedPlantMode = prefs.getInt("plantMode", PLANT_TOMATO);

  if (savedPlantMode == PLANT_PAPRIKA) {
    plantMode = PLANT_PAPRIKA;
  } else {
    plantMode = PLANT_TOMATO;
  }

  selectedPlantMode = plantMode;

  Serial.print("Loaded saved runtime: ");
  Serial.print(savedRuntimeMs / 1000);
  Serial.println(" seconds");

  Serial.print("Loaded plant mode: ");
  Serial.println(getPlantModeName(plantMode));

  pinMode(PUMP_PIN, OUTPUT);
  digitalWrite(PUMP_PIN, LOW);

  pinMode(BUTTON_PIN, INPUT_PULLUP);

  dht.begin();

  Wire.begin(I2C_SDA, I2C_SCL);

  if (lightMeter.begin(BH1750::CONTINUOUS_HIGH_RES_MODE)) {
    Serial.println("BH1750 started.");
  } else {
    Serial.println("BH1750 error. Check SDA/SCL wiring.");
  }

  u8g2.begin();
  u8g2.clearBuffer();
  u8g2.setFont(u8g2_font_6x10_tf);
  u8g2.drawStr(0, 12, "Grow Box Starting...");
  u8g2.drawStr(0, 28, getPlantModeName(plantMode));
  u8g2.drawStr(0, 44, "Runtime loaded");
  u8g2.sendBuffer();

  FastLED.addLeds<WS2812B, LED_PIN, GRB>(leds, NUM_LEDS);
  FastLED.setBrightness(cfg.ledBrightness);
  setGrowLights(false);

  ventServo.setPeriodHertz(50);
  ventServo.attach(SERVO_PIN, 500, 2400);
  ventServo.write(cfg.servoClosed);

  analogReadResolution(12);
  analogSetPinAttenuation(SOIL_ADC_PIN, ADC_11db);

  connectWiFi();

  if (WiFi.status() == WL_CONNECTED) {
    uploadDefaultConfig();
    resetFirebaseCommands();
    readFirebaseConfig();
  }

  Serial.println("System ready.");
}

// LOOP
void loop() {
  uint64_t now = nowMs();

  handleButton();

  GrowthStage currentStage = getCurrentStage();

  if (now - lastSensorRead >= SENSOR_INTERVAL_MS) {
    lastSensorRead = now;

    readSensors();

    if (cfg.automationEnabled) {
      controlLights(currentStage);
      controlVentilation(currentStage);
      controlWatering(currentStage);
    }

    printStatus(currentStage);
  }

  if (now - lastFirebaseRead >= FIREBASE_READ_INTERVAL_MS) {
    lastFirebaseRead = now;

    if (WiFi.status() == WL_CONNECTED) {
      readFirebaseConfig();
      readFirebaseCommands();
    }
  }

  if (now - lastFirebaseUpload >= FIREBASE_UPLOAD_INTERVAL_MS) {
    lastFirebaseUpload = now;

    if (WiFi.status() == WL_CONNECTED) {
      uploadStatusToFirebase(currentStage);
    }
  }

  if (now - lastLcdUpdate >= LCD_UPDATE_INTERVAL_MS) {
    lastLcdUpdate = now;
    drawLcd(currentStage);
  }

  if (now - lastRuntimeSave >= RUNTIME_SAVE_INTERVAL_MS) {
    lastRuntimeSave = now;
    saveRuntimeToFlash();
  }
}
