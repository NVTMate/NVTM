// CONFIG VALUES EDITABLE FROM FIREBASE
struct GrowConfig {
  bool automationEnabled = true;
  int startDay = 0;
  int forceStage = -1;          // -1 = automatic, 0-4 = forced stage

  // SoilCap V2.0 calibration:
  // dry / air:        2928
  // barely damp soil: 1599
  // very wet soil:     930
  int soilDryValue = 2928;
  int soilWetValue = 930;

  // With this calibration:
  // 2928 = 0%
  // 1599 = ~66%
  // 930  = 100%
  int soilMinPercent = 45;      // pump starts below this
  int soilOkPercent = 70;       // reference/display target

  float pumpMlPerSecond = 20.0;
  unsigned long pumpStartupMs = 2500;
  unsigned long pumpWateringMs = 700;
  unsigned long pumpCooldownMs = 30000;

  int lightStartHour = 6;
  int ledBrightness = 80;

  int servoClosed = 120;
  int servoOpen = 30;

  bool autoLights = true;
  bool autoPump = true;
  bool autoVent = true;
};

