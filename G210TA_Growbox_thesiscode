// GROWTH STAGE STRUCTURE
struct GrowthStage {
  const char* name;
  int durationDays;
  float tempMin;
  float tempMax;
  int lightHours;
  int humidityMin;
  int humidityMax;
  int waterMinMlDay;
  int waterMaxMlDay;
};

// PLANT MODE
enum PlantMode {
  PLANT_TOMATO = 0,
  PLANT_PAPRIKA = 1
};

PlantMode plantMode = PLANT_TOMATO;
PlantMode selectedPlantMode = PLANT_TOMATO;
bool plantSelectMode = false;

const int STAGE_COUNT = 5;

