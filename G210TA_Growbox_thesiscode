  {"Seedling",    25, 20, 25, 14, 60, 70, 50, 100},
  {"Vegetation",  30, 20, 28, 16, 60, 70, 250, 500},
  {"Flowering",   18, 21, 24, 14, 60, 70, 500, 800},
  {"Fruiting",    25, 20, 25, 14, 60, 70, 500, 1000}
};

// PAPRIKA / SWEET PEPPER GROWTH CYCLE
