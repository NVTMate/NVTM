  if (WiFi.status() != WL_CONNECTED) return;

  String path = "/growboxes/" + String(DEVICE_ID) + "/config";
  String url = firebaseUrl(path);

  StaticJsonDocument<2048> doc;

  doc["automationEnabled"] = cfg.automationEnabled;
  doc["startDay"] = cfg.startDay;
  doc["forceStage"] = cfg.forceStage;

  doc["plantMode"] = (int)plantMode;
  doc["plantModeName"] = getPlantModeName(plantMode);

  doc["soilDryValue"] = cfg.soilDryValue;
  doc["soilWetValue"] = cfg.soilWetValue;
  doc["soilMinPercent"] = cfg.soilMinPercent;
  doc["soilOkPercent"] = cfg.soilOkPercent;

  doc["pumpMlPerSecond"] = cfg.pumpMlPerSecond;
  doc["pumpStartupMs"] = cfg.pumpStartupMs;
  doc["pumpWateringMs"] = cfg.pumpWateringMs;
  doc["pumpCooldownMs"] = cfg.pumpCooldownMs;

  doc["lightStartHour"] = cfg.lightStartHour;
  doc["ledBrightness"] = cfg.ledBrightness;

  doc["servoClosed"] = cfg.servoClosed;
  doc["servoOpen"] = cfg.servoOpen;

  doc["autoLights"] = cfg.autoLights;
  doc["autoPump"] = cfg.autoPump;
  doc["autoVent"] = cfg.autoVent;

  String json;
  serializeJson(doc, json);

  HTTPClient http;
  http.begin(url);
  http.addHeader("Content-Type", "application/json");

  int httpCode = http.PUT(json);

  Serial.print("Default config upload HTTP code: ");
  Serial.println(httpCode);

  http.end();
}

// FIREBASE: RESET COMMANDS
void resetFirebaseCommands() {
  if (WiFi.status() != WL_CONNECTED) return;

  String path = "/growboxes/" + String(DEVICE_ID) + "/commands";
  String url = firebaseUrl(path);

  StaticJsonDocument<256> doc;
  doc["manualPump"] = false;
  doc["openVent"] = false;
  doc["closeVent"] = false;
  doc["lightsOn"] = false;
  doc["lightsOff"] = false;
  doc["resetRuntime"] = false;

  String json;
  serializeJson(doc, json);

  HTTPClient http;
  http.begin(url);
  http.addHeader("Content-Type", "application/json");
  http.PUT(json);
  http.end();
}

// FIREBASE: READ COMMANDS
void readFirebaseCommands() {
  if (WiFi.status() != WL_CONNECTED) return;

  String path = "/growboxes/" + String(DEVICE_ID) + "/commands";
  String url = firebaseUrl(path);

  HTTPClient http;
  http.begin(url);

  int httpCode = http.GET();

  if (httpCode == 200) {
    String payload = http.getString();

    if (payload != "null") {
      StaticJsonDocument<512> doc;
      DeserializationError error = deserializeJson(doc, payload);

      if (!error) {
        bool manualPump = doc["manualPump"] | false;
        bool openVent = doc["openVent"] | false;
        bool closeVent = doc["closeVent"] | false;
        bool lightsOn = doc["lightsOn"] | false;
        bool lightsOff = doc["lightsOff"] | false;
        bool resetRuntimeCommand = doc["resetRuntime"] | false;

        if (manualPump) runPumpPulse();
        if (openVent) ventServo.write(cfg.servoOpen);
        if (closeVent) ventServo.write(cfg.servoClosed);
        if (lightsOn) setGrowLights(true);
        if (lightsOff) setGrowLights(false);
        if (resetRuntimeCommand) resetRuntime();

        if (manualPump || openVent || closeVent || lightsOn || lightsOff || resetRuntimeCommand) {
          resetFirebaseCommands();
        }
      }
    }
  }

  http.end();
}

// FIREBASE: UPLOAD STATUS
void uploadStatusToFirebase(GrowthStage stage) {
  if (WiFi.status() != WL_CONNECTED) return;

  String path = "/growboxes/" + String(DEVICE_ID) + "/status";
  String url = firebaseUrl(path);

  StaticJsonDocument<2048> doc;

  doc["deviceId"] = DEVICE_ID;
  doc["online"] = true;

  doc["plantMode"] = (int)plantMode;
  doc["plantModeName"] = getPlantModeName(plantMode);

  doc["growDay"] = getCurrentGrowDay();
  doc["currentHour"] = getCurrentHour();
  doc["stage"] = stage.name;

  doc["runtimeMs"] = getTotalRuntimeMs();
  doc["runtimeSeconds"] = getTotalRuntimeMs() / 1000;
  doc["runtimeHours"] = getTotalRuntimeMs() / 3600000.0;

  doc["temperature"] = temperature;
  doc["humidity"] = humidity;
  doc["lux"] = lux;

  doc["soilRaw"] = soilRaw;
  doc["soilPercent"] = soilPercent;
  doc["soilStatus"] = getSoilStatus();

  doc["soilCalibration"]["dryValue"] = cfg.soilDryValue;
  doc["soilCalibration"]["wetValue"] = cfg.soilWetValue;
  doc["soilCalibration"]["minPercent"] = cfg.soilMinPercent;
  doc["soilCalibration"]["okPercent"] = cfg.soilOkPercent;

  doc["waterUsedTodayMl"] = waterUsedTodayMl;

  doc["target"]["tempMin"] = stage.tempMin;
  doc["target"]["tempMax"] = stage.tempMax;
  doc["target"]["humidityMin"] = stage.humidityMin;
  doc["target"]["humidityMax"] = stage.humidityMax;
  doc["target"]["lightHours"] = stage.lightHours;
  doc["target"]["waterMinMlDay"] = stage.waterMinMlDay;
  doc["target"]["waterMaxMlDay"] = stage.waterMaxMlDay;

  doc["pump"]["startupMs"] = cfg.pumpStartupMs;
  doc["pump"]["wateringMs"] = cfg.pumpWateringMs;
  doc["pump"]["cooldownMs"] = cfg.pumpCooldownMs;
  doc["pump"]["mlPerSecond"] = cfg.pumpMlPerSecond;

  String json;
  serializeJson(doc, json);

  HTTPClient http;
  http.begin(url);
  http.addHeader("Content-Type", "application/json");

  int httpCode = http.PUT(json);

  Serial.print("Status upload HTTP code: ");
  Serial.println(httpCode);

  http.end();
}

