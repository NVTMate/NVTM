// TIME HELPER
uint64_t nowMs() {
  return esp_timer_get_time() / 1000ULL;
}

// TOTAL MACHINE RUNTIME
uint64_t getTotalRuntimeMs() {
  return savedRuntimeMs + (nowMs() - bootTimeMs);
}

void saveRuntimeToFlash() {
  uint64_t totalRuntime = getTotalRuntimeMs();
  prefs.putULong64("runtimeMs", totalRuntime);

  Serial.print("Runtime saved: ");
  Serial.print(totalRuntime / 1000);
  Serial.println(" seconds");
}

void resetRuntime() {
  savedRuntimeMs = 0;
  bootTimeMs = nowMs();
  prefs.putULong64("runtimeMs", 0);

  waterUsedTodayMl = 0;
  previousDay = -1;

  Serial.println("Runtime reset to 0.");
}

// FIREBASE URL HELPER
String firebaseUrl(String path) {
  String url = String(FIREBASE_DATABASE_URL) + path + ".json";

  if (String(FIREBASE_AUTH_TOKEN).length() > 0) {
    url += "?auth=";
    url += FIREBASE_AUTH_TOKEN;
  }

  return url;
}

// CURRENT GROW DAY AND HOUR
int getCurrentGrowDay() {
  return cfg.startDay + (getTotalRuntimeMs() / DAY_LENGTH_MS);
}

int getCurrentHour() {
  uint64_t timeToday = getTotalRuntimeMs() % DAY_LENGTH_MS;
  return (timeToday * 24ULL) / DAY_LENGTH_MS;
}

// CURRENT GROWTH STAGE
GrowthStage getCurrentStage() {
  GrowthStage* stages = getActiveStages();

  if (cfg.forceStage >= 0 && cfg.forceStage < STAGE_COUNT) {
    return stages[cfg.forceStage];
  }

  int day = getCurrentGrowDay();
  int accumulatedDays = 0;

  for (int i = 0; i < STAGE_COUNT; i++) {
    accumulatedDays += stages[i].durationDays;

    if (day < accumulatedDays) {
      return stages[i];
    }
  }

  return stages[STAGE_COUNT - 1];
}

// SOIL MOISTURE
int readSoilRawAverage() {
  const int samples = 15;
  long total = 0;

  for (int i = 0; i < samples; i++) {
    total += analogRead(SOIL_ADC_PIN);
    delay(5);
  }

  return total / samples;
}

int readSoilPercent() {
  int raw = readSoilRawAverage();
  soilRaw = raw;

  int percent = map(raw, cfg.soilDryValue, cfg.soilWetValue, 0, 100);
  percent = constrain(percent, 0, 100);

  return percent;
}

const char* getSoilStatus() {
  if (soilPercent < cfg.soilMinPercent) {
    return "DRY";
  } else if (soilPercent < cfg.soilOkPercent) {
    return "DAMP";
  } else {
    return "WET";
  }
}

// LED CONTROL
void setGrowLights(bool on) {
  FastLED.setBrightness(cfg.ledBrightness);

  if (on) {
    for (int i = 0; i < NUM_LEDS; i++) {
      leds[i] = CRGB(180, 0, 120);
    }
  } else {
    for (int i = 0; i < NUM_LEDS; i++) {
      leds[i] = CRGB::Black;
    }
  }

  FastLED.show();
}

void controlLights(GrowthStage stage) {
  if (!cfg.autoLights) return;

  int hour = getCurrentHour();

  if (stage.lightHours <= 0) {
    setGrowLights(false);
    return;
  }

  int lightEndHour = cfg.lightStartHour + stage.lightHours;
  bool lightShouldBeOn = false;

  if (lightEndHour <= 24) {
    lightShouldBeOn = (hour >= cfg.lightStartHour && hour < lightEndHour);
  } else {
    int wrappedEnd = lightEndHour - 24;
    lightShouldBeOn = (hour >= cfg.lightStartHour || hour < wrappedEnd);
  }

  setGrowLights(lightShouldBeOn);
}

// SERVO VENTILATION
void controlVentilation(GrowthStage stage) {
  if (!cfg.autoVent) return;

  bool tooHot = temperature > stage.tempMax;
  bool tooHumid = humidity > stage.humidityMax;

  if (tooHot || tooHumid) {
    ventServo.write(cfg.servoOpen);
  } else {
    ventServo.write(cfg.servoClosed);
  }
}

// PUMP CONTROL WITH STARTUP / PRIMING DELAY
void runPumpPulse() {
  Serial.println("Pump starting / priming...");

  digitalWrite(PUMP_PIN, HIGH);
  delay(cfg.pumpStartupMs);

  Serial.println("Pump should now be delivering water...");

  delay(cfg.pumpWateringMs);
  digitalWrite(PUMP_PIN, LOW);

  lastPumpRun = nowMs();

  float pumpedMl = (cfg.pumpWateringMs / 1000.0) * cfg.pumpMlPerSecond;
  waterUsedTodayMl += pumpedMl;

  Serial.print("Pump startup time: ");
  Serial.print(cfg.pumpStartupMs);
  Serial.println(" ms");

  Serial.print("Actual watering time: ");
  Serial.print(cfg.pumpWateringMs);
  Serial.println(" ms");

  Serial.print("Estimated water added: ");
  Serial.print(pumpedMl);
  Serial.println(" ml");
}

void controlWatering(GrowthStage stage) {
  if (!cfg.autoPump) return;

  uint64_t now = nowMs();
  int currentDay = getCurrentGrowDay();

  if (currentDay != previousDay) {
    previousDay = currentDay;
    waterUsedTodayMl = 0;
  }

  bool soilTooDry = soilPercent < cfg.soilMinPercent;
  bool cooldownPassed = (now - lastPumpRun) > cfg.pumpCooldownMs;
  bool dailyLimitNotReached = waterUsedTodayMl < stage.waterMaxMlDay;

  if (soilTooDry && cooldownPassed && dailyLimitNotReached) {
    runPumpPulse();
  }
}

// SENSOR READING
void readSensors() {
  float newTemp = dht.readTemperature();
  float newHum = dht.readHumidity();

  if (!isnan(newTemp)) {
    temperature = newTemp;
  } else {
    Serial.println("DHT temperature read failed.");
  }

  if (!isnan(newHum)) {
    humidity = newHum;
  } else {
    Serial.println("DHT humidity read failed.");
  }

  lux = lightMeter.readLightLevel();
  soilPercent = readSoilPercent();
}

// LCD PLANT SELECTION SCREEN
void drawPlantSelectScreen() {
  u8g2.clearBuffer();
  u8g2.setFont(u8g2_font_6x10_tf);

  char line[32];

  u8g2.drawStr(0, 10, "Select grow mode");

  snprintf(line, sizeof(line), "> %s", getPlantModeName(selectedPlantMode));
  u8g2.drawStr(0, 26, line);

  u8g2.drawStr(0, 40, "Short: switch");
  u8g2.drawStr(0, 52, "Long: confirm");
  u8g2.drawStr(0, 63, "0.8-4.9 sec");

  u8g2.sendBuffer();
}

void enterPlantSelectMode() {
  plantSelectMode = true;
  selectedPlantMode = plantMode;
  lcdEnabled = true;

  drawPlantSelectScreen();

  Serial.println("Plant selection mode started.");
}

void switchSelectedPlantMode() {
  if (selectedPlantMode == PLANT_TOMATO) {
    selectedPlantMode = PLANT_PAPRIKA;
  } else {
    selectedPlantMode = PLANT_TOMATO;
  }

  drawPlantSelectScreen();

  Serial.print("Selected plant mode: ");
  Serial.println(getPlantModeName(selectedPlantMode));
}

void confirmPlantMode() {
  bool changed = (plantMode != selectedPlantMode);

  plantMode = selectedPlantMode;
  prefs.putInt("plantMode", (int)plantMode);

  plantSelectMode = false;

  if (changed) {
    waterUsedTodayMl = 0;
    previousDay = -1;
  }

  u8g2.clearBuffer();
  u8g2.setFont(u8g2_font_6x10_tf);
  u8g2.drawStr(0, 16, "Grow mode saved:");
  u8g2.drawStr(0, 34, getPlantModeName(plantMode));
  u8g2.drawStr(0, 52, "Returning...");
  u8g2.sendBuffer();

  Serial.print("Confirmed plant mode: ");
  Serial.println(getPlantModeName(plantMode));

  delay(1200);
}

void nextLcdPage() {
  lcdPage++;

  if (lcdPage >= LCD_PAGE_COUNT) {
    lcdPage = 0;
  }
}

void toggleLcdPower() {
  lcdEnabled = !lcdEnabled;

  if (!lcdEnabled) {
    u8g2.clearBuffer();
    u8g2.sendBuffer();
  }
}

// BUTTON CONTROL
// Normal mode:
// Short press = change LCD page
// Long press 0.8-4.9s = LCD on/off
// Very long press 5s+ = enter plant selection mode
//
// Plant selection mode:
// Short press = switch Tomato/Paprika
// Long press 0.8-4.9s = confirm selected plant
void handleButton() {
  bool buttonState = digitalRead(BUTTON_PIN);
  uint64_t now = nowMs();

  // Button pressed
  if (lastButtonState == HIGH && buttonState == LOW) {
    buttonPressStart = now;
    longPressHandled = false;
  }

  // Very long press while holding: enter plant selection mode
  if (lastButtonState == LOW && buttonState == LOW && !longPressHandled) {
    uint64_t pressDuration = now - buttonPressStart;

    if (!plantSelectMode && pressDuration >= BUTTON_VERY_LONG_MS) {
      enterPlantSelectMode();
      longPressHandled = true;
    }
  }

  // Button released
  if (lastButtonState == LOW && buttonState == HIGH) {
    uint64_t pressDuration = now - buttonPressStart;

    if (!longPressHandled) {
      // Short press
      if (pressDuration < BUTTON_LONG_MIN_MS) {
        if (plantSelectMode) {
          switchSelectedPlantMode();
        } else {
          nextLcdPage();
        }
      }

      // Normal long press: 0.8 - 4.9 seconds
      else if (pressDuration >= BUTTON_LONG_MIN_MS && pressDuration < BUTTON_VERY_LONG_MS) {
        if (plantSelectMode) {
          confirmPlantMode();
        } else {
          toggleLcdPower();
        }
      }
    }
  }

  lastButtonState = buttonState;
}

// LCD DISPLAY
void drawLcd(GrowthStage stage) {
  if (!lcdEnabled) return;

  if (plantSelectMode) {
    drawPlantSelectScreen();
    return;
  }

  u8g2.clearBuffer();
  u8g2.setFont(u8g2_font_6x10_tf);

  char line[32];

  if (lcdPage == 0) {
    u8g2.drawStr(0, 10, "Grow Box 1/4");

    snprintf(line, sizeof(line), "Day: %d Hour: %d", getCurrentGrowDay(), getCurrentHour());
    u8g2.drawStr(0, 24, line);

    snprintf(line, sizeof(line), "Stage: %s", stage.name);
    u8g2.drawStr(0, 36, line);

    snprintf(line, sizeof(line), "Plant: %s", getPlantModeName(plantMode));
    u8g2.drawStr(0, 50, line);
  }

  else if (lcdPage == 1) {
    u8g2.drawStr(0, 10, "Climate 2/4");

    snprintf(line, sizeof(line), "Temp: %.1f C", temperature);
    u8g2.drawStr(0, 24, line);

    snprintf(line, sizeof(line), "Hum: %.1f %%", humidity);
    u8g2.drawStr(0, 36, line);

    snprintf(line, sizeof(line), "Target: %.0f-%.0fC", stage.tempMin, stage.tempMax);
    u8g2.drawStr(0, 50, line);
  }

  else if (lcdPage == 2) {
    u8g2.drawStr(0, 10, "Soil/Light 3/4");

    snprintf(line, sizeof(line), "Soil: %d %% %s", soilPercent, getSoilStatus());
    u8g2.drawStr(0, 24, line);

    snprintf(line, sizeof(line), "Raw: %d", soilRaw);
    u8g2.drawStr(0, 36, line);

    snprintf(line, sizeof(line), "Lux: %.0f", lux);
    u8g2.drawStr(0, 50, line);
  }

  else if (lcdPage == 3) {
    u8g2.drawStr(0, 10, "System 4/4");

    snprintf(line, sizeof(line), "Auto: %s", cfg.automationEnabled ? "ON" : "OFF");
    u8g2.drawStr(0, 24, line);

    snprintf(line, sizeof(line), "Run: %.1f h", getTotalRuntimeMs() / 3600000.0);
    u8g2.drawStr(0, 36, line);

    snprintf(line, sizeof(line), "WiFi: %s", WiFi.status() == WL_CONNECTED ? "OK" : "NO");
    u8g2.drawStr(0, 50, line);
  }

  u8g2.sendBuffer();
}

// FIREBASE: READ CONFIG
void readFirebaseConfig() {
  if (WiFi.status() != WL_CONNECTED) return;

  String path = "/growboxes/" + String(DEVICE_ID) + "/config";
  String url = firebaseUrl(path);

  HTTPClient http;
  http.begin(url);

  int httpCode = http.GET();

  if (httpCode == 200) {
    String payload = http.getString();

    if (payload != "null") {
      StaticJsonDocument<2048> doc;
      DeserializationError error = deserializeJson(doc, payload);

      if (!error) {
        if (doc["automationEnabled"].is<bool>()) cfg.automationEnabled = doc["automationEnabled"];
        if (doc["startDay"].is<int>()) cfg.startDay = doc["startDay"];
        if (doc["forceStage"].is<int>()) cfg.forceStage = doc["forceStage"];

        if (doc["plantMode"].is<int>()) {
          int firebasePlantMode = doc["plantMode"];

          if (firebasePlantMode == PLANT_PAPRIKA) {
            plantMode = PLANT_PAPRIKA;
          } else {
            plantMode = PLANT_TOMATO;
          }

          selectedPlantMode = plantMode;
          prefs.putInt("plantMode", (int)plantMode);
        }

        if (doc["soilDryValue"].is<int>()) cfg.soilDryValue = doc["soilDryValue"];
        if (doc["soilWetValue"].is<int>()) cfg.soilWetValue = doc["soilWetValue"];
        if (doc["soilMinPercent"].is<int>()) cfg.soilMinPercent = doc["soilMinPercent"];
        if (doc["soilOkPercent"].is<int>()) cfg.soilOkPercent = doc["soilOkPercent"];

        if (doc["pumpMlPerSecond"].is<float>()) cfg.pumpMlPerSecond = doc["pumpMlPerSecond"];

        if (doc["pumpStartupMs"].is<int>()) cfg.pumpStartupMs = doc["pumpStartupMs"];
        if (doc["pumpWateringMs"].is<int>()) cfg.pumpWateringMs = doc["pumpWateringMs"];
        if (doc["pumpCooldownMs"].is<int>()) cfg.pumpCooldownMs = doc["pumpCooldownMs"];

        if (doc["lightStartHour"].is<int>()) cfg.lightStartHour = doc["lightStartHour"];
        if (doc["ledBrightness"].is<int>()) cfg.ledBrightness = constrain((int)doc["ledBrightness"], 0, 255);

        if (doc["servoClosed"].is<int>()) cfg.servoClosed = constrain((int)doc["servoClosed"], 0, 180);
        if (doc["servoOpen"].is<int>()) cfg.servoOpen = constrain((int)doc["servoOpen"], 0, 180);

        if (doc["autoLights"].is<bool>()) cfg.autoLights = doc["autoLights"];
        if (doc["autoPump"].is<bool>()) cfg.autoPump = doc["autoPump"];
        if (doc["autoVent"].is<bool>()) cfg.autoVent = doc["autoVent"];

        Serial.println("Firebase config updated.");
      } else {
        Serial.println("Firebase JSON parse failed.");
      }
    }
  } else {
    Serial.print("Firebase config read HTTP error: ");
    Serial.println(httpCode);
  }

  http.end();
}

// FIREBASE: UPLOAD DEFAULT CONFIG
